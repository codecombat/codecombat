extends /templates/base

block content
  div
    ol.breadcrumb
      li
        a(href="/editor", data-i18n="editor.main_title") CodeCombat Editors
      li
        a(href="/editor/ai-story-world", data-i18n="editor.ai_story_world_title")
      li.active
        | #{view.model.get('name')}

  - var authorized = !me.get('anonymous');
  button.ai-story-world-tool-button.btn.btn-primary#i18n-button(data-i18n="editor.pop_i18n", disabled=authorized === true ? undefined : "true")
  button.ai-story-world-tool-button.btn.btn-primary#delete-button(data-i18n="editor.delete", disabled=me.isAdmin() === true ? undefined : "true")
  button.ai-story-world-tool-button.btn.btn-primary#save-button(data-i18n="common.save", disabled=authorized === true ? undefined : "true")

  h3
    span(data-i18n="editor.ai_story_world_edit_title")
    |: #{view.model.get('name')}
    if view.model.get('slug')
      |  (#{view.model.get('slug')})

  #ai-story-world-treema
