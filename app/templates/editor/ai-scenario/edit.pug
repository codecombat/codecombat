extends /templates/base

block content
  div
    ol.breadcrumb
      li
        a(href="/editor", data-i18n="editor.main_title") CodeCombat Editors
      li
        a(href="/editor/ai-scenario", data-i18n="editor.ai_scenario_title")
      li.active
        | #{view.scenario.get('_id')}

  - var authorized = !me.get('anonymous');
  button.ai-scenario-tool-button(data-i18n="general.version_history").btn.btn-primary#history-button Version History
  button.ai-scenario-tool-button(data-toggle="coco-modal", data-target="modal/RevertModal", data-i18n="editor.revert", disabled=authorized === true ? undefined : "true").btn.btn-primary#revert-button Revert
  button.ai-scenario-tool-button.btn.btn-primary#i18n-button(data-i18n="editor.pop_i18n", disabled=authorized === true ? undefined : "true")
  button.ai-scenario-tool-button.btn.btn-primary#ai-translate-button(data-i18n="editor.ai_translate", disabled=authorized === true ? undefined : "true")
  button.ai-scenario-tool-button.btn.btn-primary#delete-button(data-i18n="editor.delete", disabled=me.isAdmin() === true ? undefined : "true")
  button.ai-scenario-tool-button.btn.btn-primary#play-button(data-i18n="[title]editor.play_scenario_title;editor.play_scenario", disabled=authorized === true ? undefined : "true")
  button.ai-scenario-tool-button.btn.btn-primary#fork-button(data-i18n="editor.fork_scenario", disabled=authorized === true ? undefined : "true")
  button.ai-scenario-tool-button.btn.btn-primary#save-button(data-i18n="common.save", disabled=authorized === true ? undefined : "true")

  h3
    span(data-i18n="editor.ai_scenario_edit_title")
    |: #{view.scenario.attributes._id}

  p
    span Original Id
    |: #{view.scenario.get('original')}

  ul.nav.nav-tabs#ai-scenario-tabs
    li.active
      a(href="#ai-scenario-script-tab", data-toggle="tab", data-i18n="editor.scenario_script_tab") Script
    li
      a(href="#ai-scenario-settings-tab", data-toggle="tab", data-i18n="play.settings") Settings
    li
      a(href="#ai-scenario-patches-tab", data-toggle="tab", data-i18n="resources.patches") Patches

  .tab-content
    .tab-pane.active#ai-scenario-script-tab
      #scenario-script-panel
    .tab-pane#ai-scenario-settings-tab
      #ai-scenario-treema
    .tab-pane#ai-scenario-patches-tab
      .patches-view
