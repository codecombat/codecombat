extends /templates/base-empty

block content
  #minigame-play-content
    .minigame-error(style="display: none; color: #fff; font-family: monospace; padding: 24px; text-align: center;")
    #minigame-host(style="width: 100%; max-width: min(1920px, calc((100vh - 32px) * 16 / 9)); aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px;")
